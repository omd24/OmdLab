# This character's moveset - per-character content, cross-referenced from the shared state
# topology only through generic flags (moveSelected, hitConfirmed, ...), never by name.
#
# startup + active + recovery is the Attack STATE's length in 60Hz frames (rescaled by the
# global speed multiplier at load): how long the fighter is committed / input-locked. It is NOT
# the clip's length. The state now ends right after the strike (startup + active), and the
# limb's return-to-neutral plays out in interruptible Idle via the Attack->Idle crossfade -
# so the player can walk / jump / attack again the instant the hit resolves instead of watching
# a locked recovery animation. Keep recovery tiny (a few frames of settle) unless a move
# deliberately wants a punishable whiff window. (punch clip 0.667s, kick_light clip 1.300s, for
# reference - the state is far shorter than both now, by design.)
#
# A hitbox's optional "bone" field names a real joint (see the character's own skeleton - e.g.
# "RightHand_014", "RightFoot_020") for the box to follow through the move's animated pose,
# instead of sitting at a fixed offset from the character's root the whole active window (which
# would only ever be correctly placed for one instant of a moving limb, not the rest of it).
# offsetX/Y/Z become a small refinement relative to that joint's own current position, not the
# box's sole positioning - first-guess values below, easy to retune once real play/collision-
# debug-draw makes clear whether they read as centered on the fist/foot.
#
# `impact` is the whole game-feel layer in one word: none | light | medium | heavy (or a raw
# 0..1). It turns on a reshaped playback (eased wind-up -> snap to the strike pose -> brief
# frozen hold -> fast recovery) plus a contact freeze-frame and a forward step, all scaled by
# that one setting. Omit it (or `impact none`) and the clip plays flat, exactly as before.
# Where the strike / coil poses actually are in each clip is auto-detected at load from the
# hitbox bone - nothing to hand-find. See NOTES/COMBAT_GUIDE.md.

move punch
{
    animationClip "punch"
    inputButton Punch
    startup 8
    active 8
    recovery 0
    damage 8
    onHitStun 14
    onBlockStun 8
    guardHeight mid
    impact medium

    hitbox
    {
        bone "LeftHand_010"
        offsetX 0.282
        offsetY 0
        offsetZ 0
        halfX 0.2
        halfY 0.15
        halfZ 0.15
        # Live window, in authored 60Hz frames (rescaled with the move at load). Must sit
        # inside the Attack state (startup..startup+active) - the state now ends right after the
        # strike, so a window authored past it would never open in normal play (only with the
        # "force show all hitboxes" debug toggle, which bypasses the window check).
        frameStart 8
        frameEnd 16
    }

    cancel kick_light
    {
        require hitConfirmed
        require frame >= 10
    }
}

move kick_light
{
    animationClip "kick_light"
    inputButton Kick
    # Shorter windup so the slow coil doesn't dominate the move.
    startup 10
    active 10
    # Recovery gives the leg's return-to-neutral real time on-screen - the "recovery blend-out"
    # crossfade (now eased, see Animator::ActiveWeight) spans it and decelerates into rest.
    recovery 10
    damage 10
    onHitStun 16
    onBlockStun 10
    guardHeight mid
    impact heavy
    # Windup -> full extension, in frames AFTER the 1/1.2 load-time speed scale (author ~1.2x
    # the ticks you want). Default 3 passes through full extension in ~2 frames - too abrupt to
    # read. 7 -> ~6 runtime ticks of rise.
    timingSnapFrames 7

    hitbox
    {
        bone "LeftFoot_017"
        offsetX 0.087
        offsetY 0.2
        offsetZ 0
        halfX 0.264
        halfY 0.221
        halfZ 0.18
        # See punch's hitbox note - window kept inside startup..startup+active.
        frameStart 10
        frameEnd 20
    }
}
