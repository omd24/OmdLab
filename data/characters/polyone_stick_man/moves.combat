# This character's moveset - per-character content, cross-referenced from the shared state
# topology only through generic flags (moveSelected, hitConfirmed, ...), never by name.
#
# startup+active+recovery must sum to (roughly) the real animationClip's own duration in frames
# at 60Hz, or the state machine returns to Idle - cutting the visible clip short - well before it
# actually finishes playing. Real clip durations (from the asset import log): punch = 0.667s = 40
# frames, kick_light = 1.300s = 78 frames. First real tuning pass, still easy to retune further
# once real play makes clear whether punch/kick feel right relative to each other - just keep the
# three frame counts summing to the clip's own length.
#
# A hitbox's optional "bone" field names a real joint (see the character's own skeleton - e.g.
# "RightHand_014", "RightFoot_020") for the box to follow through the move's animated pose,
# instead of sitting at a fixed offset from the character's root the whole active window (which
# would only ever be correctly placed for one instant of a moving limb, not the rest of it).
# offsetX/Y/Z become a small refinement relative to that joint's own current position, not the
# box's sole positioning - first-guess values below, easy to retune once real play/collision-
# debug-draw makes clear whether they read as centered on the fist/foot.

move punch
{
    animationClip "punch"
    inputButton Punch
    startup 8
    active 8
    recovery 24
    damage 8
    onHitStun 14
    onBlockStun 8
    guardHeight mid

    hitbox
    {
        bone "LeftHand_010"
        offsetX 0.282
        offsetY 0
        offsetZ 0
        halfX 0.2
        halfY 0.15
        halfZ 0.15
        frameStart 14
        frameEnd 21
    }

    cancel kick_light
    {
        require hitConfirmed
        require frame >= 10
    }
}

move kick_light
{
    animationClip "kick_light"
    inputButton Kick
    startup 15
    active 10
    recovery 53
    damage 10
    onHitStun 16
    onBlockStun 10
    guardHeight mid

    hitbox
    {
        bone "LeftFoot_017"
        offsetX 0.087
        offsetY 0.2
        offsetZ 0
        halfX 0.264
        halfY 0.221
        halfZ 0.18
        frameStart 22
        frameEnd 30
    }
}
