# This character's moveset - per-character content, cross-referenced from the shared state
# topology only through generic flags (moveSelected, hitConfirmed, ...), never by name.
#
# startup + active + recovery is the Attack STATE's length in 60Hz frames (rescaled by the
# global speed multiplier at load): how long the fighter is committed / input-locked. It is NOT
# the clip's length. The state now ends right after the strike (startup + active), and the
# limb's return-to-neutral plays out in interruptible Idle via the Attack->Idle crossfade -
# so the player can walk / jump / attack again the instant the hit resolves instead of watching
# a locked recovery animation. Keep recovery tiny (a few frames of settle) unless a move
# deliberately wants a punishable whiff window. (punch clip 0.667s, kick_light clip 1.300s, for
# reference - the state is far shorter than both now, by design.)
#
# A move with its own "cancel" block needs enough recovery to give that cancel's `frame >= N`
# condition real room to be true before the state ends on its own - recovery 0 leaves only the
# few ticks between N and startup+active, too narrow to hit reliably by hand (confirmed live:
# a punch->hook_light->hook_heavy chain landed maybe half the time even mashing fast). 10 is the
# proven-working width (kick_light's own recovery, whose follow-up chains reliably) - every
# combo-linking move below uses it for that reason, not because 10 is otherwise special.
#
# A hitbox's optional "bone" field names a real joint (see the character's own skeleton - e.g.
# "RightHand_014", "RightFoot_020") for the box to follow through the move's animated pose,
# instead of sitting at a fixed offset from the character's root the whole active window (which
# would only ever be correctly placed for one instant of a moving limb, not the rest of it).
# offsetX/Y/Z become a small refinement relative to that joint's own current position, not the
# box's sole positioning - first-guess values below, easy to retune once real play/collision-
# debug-draw makes clear whether they read as centered on the fist/foot.
#
# `impact` is the whole game-feel layer in one word: none | light | medium | heavy (or a raw
# 0..1). It turns on a reshaped playback (eased wind-up -> snap to the strike pose -> brief
# frozen hold -> fast recovery) plus a contact freeze-frame and a forward step, all scaled by
# that one setting. Omit it (or `impact none`) and the clip plays flat, exactly as before.
# Where the strike / coil poses actually are in each clip is auto-detected at load from the
# hitbox bone - nothing to hand-find.

move punch
{
    animationClip "punch"
    inputButton Punch
    startup 8
    active 8
    # Was 0 - left the cancel window below (frame >= 10) open for only ~4 runtime ticks
    # (~67ms) before the state's own end, since nothing extended it past the strike. Raised to
    # match kick_light's own recovery (already proven wide enough that its own follow-up chains
    # reliably) rather than inventing a new number - widens the window to ~12 ticks (~200ms) and
    # gives this move a real blend-out-to-idle tail instead of a hard cut when not canceled.
    recovery 10
    damage 8
    onHitStun 14
    onBlockStun 8
    guardHeight mid
    impact medium

    hitbox
    {
        bone "LeftHand_010"
        offsetX 0.282
        offsetY 0
        offsetZ 0
        halfX 0.2
        halfY 0.15
        halfZ 0.15
        # Live window, in authored 60Hz frames (rescaled with the move at load). Must sit
        # inside the Attack state (startup..startup+active) - the state now ends right after the
        # strike, so a window authored past it would never open in normal play (only with the
        # "force show all hitboxes" debug toggle, which bypasses the window check).
        frameStart 8
        frameEnd 16
    }

    # Same button (Punch) can cancel to either follow-up below - which one fires depends only
    # on which of THEIR own cancel conditions is met first (both require the same frame here,
    # so in practice whichever the DSL evaluates first wins if both are somehow legal on the
    # same tick, which they aren't - hitConfirmed plus the button press already disambiguates
    # in practice, since only one attack is active at a time).
    cancel kick_light
    {
        require hitConfirmed
        require frame >= 10
    }
    cancel hook_light
    {
        require hitConfirmed
        require frame >= 10
    }
}

move hook_light
{
    # Punch-chain follow-up: punch, punch. Same striking hand as "punch" (confirmed by
    # sampling which bone actually travels furthest during this clip, not assumed).
    animationClip "hook_light"
    inputButton Punch
    # A hook's own strike is a lateral/rotational arc, not a forward reach - this clip's resting
    # guard stance holds the hand FARTHER from the body than the actual punch-out does, so the
    # auto-detect (furthest-from-centroid) locks onto the guard pose instead of the strike.
    # Pinned from the real coil-then-snap instead: reach dips (coil) around clip fraction 0.41,
    # then a local rise (the strike) around 0.51.
    timingWindup 0.41
    timingContact 0.51
    startup 8
    active 8
    # Was 0 - same narrow-cancel-window issue as punch's own recovery, same fix.
    recovery 10
    damage 9
    onHitStun 14
    onBlockStun 8
    guardHeight mid
    impact medium

    hitbox
    {
        bone "LeftHand_010"
        offsetX 0.282
        offsetY 0
        offsetZ 0
        halfX 0.2
        halfY 0.15
        halfZ 0.15
        frameStart 8
        frameEnd 16
    }

    cancel hook_heavy
    {
        require hitConfirmed
        require frame >= 10
    }
    cancel kick_heavy
    {
        require hitConfirmed
        require frame >= 10
    }
}

move hook_heavy
{
    # Punch-chain ender: punch, punch, punch. Heavier commitment (impact heavy, more recovery)
    # than the two hits leading into it - no cancels of its own, the string ends here.
    animationClip "hook_heavy"
    inputButton Punch
    # Auto-detect's furthest-from-centroid pick (contact~0.74) turned out to be a second,
    # unrelated bump later in the clip, not the real hook - same lateral-vs-forward-reach issue
    # hook_light had. Pinned from the real coil-then-snap: reach dips (coil) at clip fraction
    # 0.33 (this part DID match the auto-detect), then a sharp, clean peak at 0.41 - the snap.
    timingWindup 0.33
    timingContact 0.41
    startup 10
    active 10
    recovery 8
    damage 16
    onHitStun 18
    onBlockStun 12
    guardHeight mid
    impact heavy
    # As a combo ender this needs to read as the heaviest of the three punches, not just deal the
    # most damage - "heavy" impact alone gives it the same hitStop/lunge as any other heavy hit
    # (3 ticks / 0.42), and left at the default (unset) snap it snapped through windup->contact in
    # just 3 ticks - too fast to register as a deliberate blow, confirmed by real play landing
    # this exact hit and reading it as barely there. Explicit overrides push all three past the
    # normal "heavy" ceiling: a slower, more visible snap (still faster than a Kick's own, this
    # is a punch), and a longer freeze + harder forward drive on contact.
    timingSnapFrames 7
    hitStop 6
    lunge 0.55

    hitbox
    {
        bone "LeftHand_010"
        offsetX 0.282
        offsetY 0
        offsetZ 0
        halfX 0.2
        halfY 0.15
        halfZ 0.15
        frameStart 10
        frameEnd 20
    }
}

move kick_light
{
    animationClip "kick_light"
    inputButton Kick
    # Shorter windup so the slow coil doesn't dominate the move.
    startup 10
    active 10
    # Recovery gives the leg's return-to-neutral real time on-screen - the "recovery blend-out"
    # crossfade (now eased, see Animator::ActiveWeight) spans it and decelerates into rest.
    recovery 10
    damage 10
    onHitStun 16
    onBlockStun 10
    guardHeight mid
    impact heavy
    # Windup -> full extension, in frames AFTER the 1/1.2 load-time speed scale (author ~1.2x
    # the ticks you want). Default 3 passes through full extension in ~2 frames - too abrupt to
    # read. 7 -> ~6 runtime ticks of rise.
    timingSnapFrames 7

    cancel kick_low
    {
        require hitConfirmed
        require frame >= 12
    }

    hitbox
    {
        bone "LeftFoot_017"
        offsetX 0.087
        offsetY 0.2
        offsetZ 0
        halfX 0.264
        halfY 0.221
        halfZ 0.18
        # See punch's hitbox note - window kept inside startup..startup+active.
        frameStart 10
        frameEnd 20
    }
}

move kick_low
{
    # Kick-chain follow-up: kick, kick. A low kick - must be blocked crouching, not standing.
    # Uses the OTHER leg than kick_light (confirmed by sampling which foot actually travels
    # furthest during this clip - it isn't always the same one clip to clip).
    animationClip "kick_low_crouch"
    inputButton Kick
    startup 8
    active 8
    # Was 0 - same narrow-cancel-window issue as punch's own recovery, same fix.
    recovery 10
    damage 8
    onHitStun 14
    onBlockStun 8
    guardHeight low
    impact medium
    # Default snap let this one snap out abruptly - same fix kick_light needed.
    timingSnapFrames 9

    hitbox
    {
        bone "RightFoot_020"
        # A crouching low kick keeps the foot lower and doesn't reach as far forward as a
        # standing kick - kick_light's own box (unchanged offsetY 0.2) never connected here even
        # point-blank. Lower + a touch more reach as a first guess, which turned out fine once a
        # separate bug (the hitbox tracking the wrong instant of the clip - see FighterState.cpp's
        # ResolveHitboxOffset) was fixed; no further retuning needed.
        offsetX 0.15
        offsetY 0.0
        offsetZ 0
        halfX 0.3
        halfY 0.221
        halfZ 0.18
        frameStart 8
        frameEnd 16
    }

    # Same button (Kick) can cancel to either follow-up below, mirroring hook_light's own two
    # cancels - the kick chain gets a kick ender (kick_heavy) and a punch-button ender
    # (hook_heavy), same as the punch chain has a punch ender and a kick-button ender.
    cancel kick_heavy
    {
        require hitConfirmed
        require frame >= 10
    }
    cancel hook_heavy
    {
        require hitConfirmed
        require frame >= 10
    }
}

move kick_heavy
{
    # Kick-chain ender: kick, kick, kick. Also the ender for punch, punch, kick (hook_light's
    # own cancel list points here too). Same other-leg finding as kick_low.
    animationClip "kick_heavy"
    inputButton Kick
    startup 10
    active 10
    recovery 10
    damage 18
    onHitStun 18
    onBlockStun 12
    guardHeight mid
    impact heavy
    # Default snap let this one snap out abruptly - same fix kick_light needed.
    timingSnapFrames 10
    # Ender emphasis, same reasoning as hook_heavy's own override just above: "heavy" impact's
    # normal hitStop/lunge ceiling (3 ticks / 0.42) doesn't distinguish a combo finisher from any
    # other heavy hit. Pushed past it so the last hit of a kick string plants harder and holds
    # a beat longer than the two before it.
    hitStop 6
    lunge 0.55

    hitbox
    {
        bone "RightFoot_020"
        offsetX 0.087
        offsetY 0.2
        offsetZ 0
        halfX 0.264
        halfY 0.221
        halfZ 0.18
        frameStart 10
        frameEnd 20
    }
}

# Aerial moves - `stance air` makes a move selectable only while airborne (and a ground move
# never while airborne), so Punch/Kick mid-jump resolve here instead of to the ground strings
# above. There is no dedicated aerial animation: each reuses an existing ground clip and its
# hitbox bone, with the same timing and frame data as the move it borrows from, so retuning the
# shared clip tunes both. An aerial move has no lunge (the jump already carries the fighter
# sideways), no cancels, and is cut off if the fighter lands before it finishes.

move jump_punch
{
    # Borrows punch: same clip, striking hand and timing.
    animationClip "punch"
    inputButton Punch
    stance air
    startup 8
    active 8
    recovery 10
    damage 8
    onHitStun 14
    onBlockStun 8
    guardHeight overhead
    impact medium

    hitbox
    {
        bone "LeftHand_010"
        offsetX 0.282
        offsetY 0
        offsetZ 0
        halfX 0.2
        halfY 0.15
        halfZ 0.15
        frameStart 8
        frameEnd 16
    }
}

move jump_kick
{
    # Borrows kick_heavy: same clip, striking foot and timing - minus its combo-ender hitStop/
    # lunge emphasis, which is about finishing a string, not about a jump-in.
    animationClip "kick_heavy"
    inputButton Kick
    stance air
    startup 10
    active 10
    recovery 10
    damage 14
    onHitStun 18
    onBlockStun 12
    guardHeight overhead
    impact heavy
    timingSnapFrames 10

    hitbox
    {
        bone "RightFoot_020"
        offsetX 0.087
        offsetY 0.2
        offsetZ 0
        halfX 0.264
        halfY 0.221
        halfZ 0.18
        frameStart 10
        frameEnd 20
    }
}
