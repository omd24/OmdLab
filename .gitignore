# Private design scratchpad - not tracked
DESIGN*.md
NOTES/

# Local asset-pipeline tooling - not tracked
/scripts/

# Sharpmake-generated solution/build output (regenerate via GenerateSolution.bat)
/projects/
/tmp/
/bin/

# Runtime logs
/logs/

# Visual Studio
.vs/
*.vcxproj.user

# Stray build artifacts outside tmp/bin (safety net) - vendored thirdParty binaries excluded
*.pdb
*.ilk
*.exe
*.obj
!thirdParty/**/*.pdb
!thirdParty/**/*.ilk
!thirdParty/**/*.exe
!thirdParty/**/*.obj

# Misc
*.log

# ImGui's window-layout autosave (per-machine, regenerated on first run)
/imgui.ini
